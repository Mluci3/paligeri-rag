# Copie para .env e preencha com seus valores (o .env nunca vai para o Git)

# Azure OpenAI / AI Foundry
AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
AZURE_OPENAI_KEY=<sua-chave>
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Opcionais
# true para modelos de raciocínio (gpt-5.x, o-series); false para gpt-4o
AZURE_OPENAI_REASONING=true
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<seu-search>.search.windows.net
AZURE_SEARCH_KEY=<sua-chave-admin>
AZURE_SEARCH_INDEX=docs-geriatric-test
